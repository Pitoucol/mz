/* ==UserStyle==
@name           etna
@namespace      github.com/openstyles/stylus
@version        1.0.10
@description    A new userstyle
@author         Me
==/UserStyle== */

@-moz-document domain("messagerie.education.gouv.fr") {
:root{
  /* Marque (skin ministère, html[data-skin-name=harmony]) */
  --c-primary:#466964;        /* bandeau, bouton Nouveau */
  --c-primary-sel:#bdc9c7;    /* sélection */
  --c-primary-hover:#e4e9e8;  /* survol */
  --c-tab-inactive:#6b8783;     /* --c-primary éclairci (~20 %) */
  --c-tab-hover:#7a948f;
    
  /* Secondaire / liens (addon + base) */
  --c-secondary:#005A95;
  --c-secondary-hover:#0088c1;

  /* Accent Bootstrap (ministère) : cases cochées, .btn-primary */
  --c-accent:#0d6efd;
  --c-success:#198754;
  --c-warning:#ffc107;
  --c-danger:#dc3545;
  --c-info:#0dcaf0;

  /* Neutres (base) */
  --c-text:#333;
  --c-text-muted:#999;
  --c-surface:#fff;
  --c-surface-alt:#f2f2f2;
  --c-border:#bfbfbf;
  --c-border-strong:#7f7f7f;
  --c-border-light:#e5e5e5;
  --c-focus:#4c6573;

  /* Marianne (ministère) */
  --c-fr-blue:#000091;
  --c-fr-red:#e1000f;

  --radius:5px;                 /* remplace --radius-checkbox : valeur globale */
}

/* Cases à cocher (sprites) : pilotées par la palette */
.ImgCheckboxUnchecked,
.ImgCheckboxChecked{
  box-sizing:border-box;
  width:16px!important;
  height:16px!important;
  margin-left:2px!important;
  border:1px solid var(--c-border-strong);
  border-radius:var(--radius);
  background-color:var(--c-surface)!important;
  background-image:none!important;
}
.ImgCheckboxChecked{
  border-color:var(--c-accent);
  background-color:var(--c-accent)!important;
  background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23fff' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m4 8 3 3 5-6'/%3e%3c/svg%3e")!important;
  background-position:center!important;
  background-size:16px 16px!important;
  background-repeat:no-repeat!important;
}

/* Onglets : ne plus rogner le haut de l'arrondi */
.ZmAppChooser,
#ztb_appChooser,
#skin_container_app_chooser{
  overflow:visible!important;
}

/* Onglets d'application */
table.ZAppTabBorder{
  border-radius:var(--radius) var(--radius) 0 0;
}

/* Onglets de formulaire (préférences, dialogues) */
.ZTab,
.ZTabBorder{
  border-radius:var(--radius) var(--radius) 0 0;
}
    
    
    
#skin_tr_main{
  padding-top:8px!important;
}

#skin_spacing_top_row .skin_table>tbody>tr:first-child{
  height:100px;   /* à ajuster */
} 
  #skin_spacing_app_row{
  height:calc(2.4rem + 3px)!important;   /* à ajuster */
}  
    
    
}
