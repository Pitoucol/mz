/* ==UserStyle==
@name           etna
@namespace      github.com/openstyles/stylus
@version        1.0.12
@description    A new userstyle
@author         Me
==/UserStyle== */

@-moz-document domain("messagerie.education.gouv.fr") {
:root{
  /* Marque (skin ministère, html[data-skin-name=harmony]) */
  --c-primary:#7a93ad/*#466964*/;        /* bandeau, bouton Nouveau */
  --c-primary-sel:#bdc9c7;    /* sélection */
  --c-primary-hover:#e4e9e8;  /* survol */
  --c-tab-inactive:#5b738b;     /* --c-primary éclairci (~20 %) */
  --c-tab-hover:#738da7;
    
  /* Secondaire / liens (addon + base) */
  --c-secondary:#005A95;
  --c-secondary-hover:#0088c1;

  /* Accent Bootstrap (ministère) : cases cochées, .btn-primary */
  --c-accent:#0d6efd;
  --c-success:#198754;
  --c-warning:#ffc107;
  --c-danger:#dc3545;
  --c-info:#0dcaf0;

  /* Neutres (base) */
  --c-text:#333;
  --c-text-muted:#999;
  --c-surface:#fff;
  --c-surface-alt:#f2f2f2;
  --c-border:#bfbfbf;
  --c-border-strong:#7f7f7f;
  --c-border-light:#e5e5e5;
  --c-focus:#4c6573;

  /* Marianne (ministère) */
  --c-fr-blue:#000091;
  --c-fr-red:#e1000f;

  --radius:5px;                 /* remplace --radius-checkbox : valeur globale */
}



/*fond nouveau message*/
html[data-skin-name="harmony"] .ZNewButton .ZToolbarButtonBorder {
  background-color: var(--c-tab-inactive) !important;
  border-color: var(--c-tab-inactive);
  transition: background-color 0.5s ease-in-out, border-color 0.5s ease-in-out;
}
 /* fond de header */
html[data-skin-name=harmony] #skin_spacing_top_row{
  background:var(--c-primary);   /* ou une valeur en dur */
  background-image:url("https://pedagogie.ac-strasbourg.fr/fileadmin/pedagogie/dane/moodlecss/drane_ge.png");
  background-repeat:no-repeat;              /* repeat pour une tuile */
  background-position: 66.67% bottom;               
}
/*Messages*/
.Conv2MsgHeader{
  background-color:var(--c-surface-alt);
  border-radius:var(--radius) var(--radius) 0 0;
}
.Collapsed .Conv2MsgHeader{
  border-radius:var(--radius);
}
.Conv2MsgHeader .date,
.Conv2Messages .Last .date{
  background:transparent;
}

/*Etiquettes*/    
.RowDouble[style*="gradient"],
.Row[style*="gradient"]{
  background-size:100% 1000%!important;
  background-position:0 100%!important;
  background-color:#a0a0a0!important;
  background-blend-mode:screen!important;
}

/* Date et zone icônes : plus de dégradé propre */
.ZmMsgListDate[style*="gradient"],
.ZmListFlagsWrapper[style*="gradient"]{
  background:none!important;
} 
    
    
/* Dernier message */
.Conv2Messages .Last{ background-color:var(--c-primary-hover); border-color:var(--c-border); }

/*messages non lus*/
    .ZmRowDoubleHeader.Unread:not([aria-selected="true"]){
  box-shadow:inset 0 0 0 100vmax rgba(0,0,0,.06);   /* intensité */
}

/* Date et zone icônes : fond propre à neutraliser */
.ZmRowDoubleHeader.Unread:not([aria-selected="true"]) .ZmMsgListDate,
.ZmRowDoubleHeader.Unread:not([aria-selected="true"]) .ZmListFlagsWrapper{
  background:transparent!important;
}
    
/* Cases à cocher (sprites) : pilotées par la palette */
.ImgCheckboxUnchecked,
.ImgCheckboxChecked{
  box-sizing:border-box;
  width:16px!important;
  height:16px!important;
  margin-left:2px!important;
  border:1px solid var(--c-border-strong);
  border-radius:var(--radius);
  background-color:var(--c-surface)!important;
  background-image:none!important;
}
.ImgCheckboxChecked{
  border-color:var(--c-accent);
  background-color:var(--c-accent)!important;
  background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23fff' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m4 8 3 3 5-6'/%3e%3c/svg%3e")!important;
  background-position:center!important;
  background-size:16px 16px!important;
  background-repeat:no-repeat!important;
}

/* Onglets : ne plus rogner le haut de l'arrondi */
.ZmAppChooser,
#ztb_appChooser,
#skin_container_app_chooser{
  overflow:visible!important;
}

/* Onglets d'application */
table.ZAppTabBorder{
  border-radius:var(--radius) var(--radius) 0 0;
}

/* Onglets de formulaire (préférences, dialogues) */
.ZTab,
.ZTabBorder{
  border-radius:var(--radius) var(--radius) 0 0;
}
  /* Onglets d'application : fond clair en permanence */
table.ZAppTabBorder{
  background-color:var(--c-tab-inactive);
}
.ZHover:not(.ZSelected) table.ZAppTabBorder,
.ZFocused:not(.ZSelected) table.ZAppTabBorder{
  background-color:var(--c-tab-hover);
}  
    
    
#skin_tr_main{
  padding-top:8px!important;
}

#skin_spacing_top_row .skin_table>tbody>tr:first-child{
  height:60px;   /* à ajuster */
} 
  #skin_spacing_app_row{
  height:calc(2.4rem + 3px)!important;  /* à ajuster */
}  
    

   .ZmMailMsgCapsuleView{
  display:flex;
  flex-direction:column;
}
.ZmMailMsgCapsuleView>.Conv2MsgHeader{
  order:-2;
}
.ZmMailMsgCapsuleView>.footer{
  padding:5px;
  opacity:1;
} 
 .ZmMailMsgCapsuleView .footer .Link{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  box-sizing:border-box;
  height:2rem;
  margin:0 2px;
  padding:0 8px;
  color:var(--c-text);
  background-color:var(--c-surface);
  border:1px solid var(--c-border);
  border-radius:var(--radius);
  text-decoration:none!important;
  white-space:nowrap;
  cursor:pointer;
}
.ZmMailMsgCapsuleView .footer .Link:hover{
  background-color: var(--c-tab-hover);
}
.ZmMailMsgCapsuleView .footer .Link:active{
  background-color: var(--c-tab-hover);
}   
    
/* Agenda */
    /* Rendez-vous : dégradé aplati + teinte pastel */
.appt_body>table[style*="gradient"],
.appt_30_body>table[style*="gradient"],
.appt_allday_body>table[style*="gradient"]{
  background-size:100% 1000%!important;
  background-position:0 100%!important;
  background-color:#bbb!important;   /* plus clair = plus pastel */
  background-blend-mode:screen!important;
}
    
.appt_body,
.appt_30_body,
.appt_allday_body{
  border-radius:5px;
}
    
.appt-selected .appt_body,
.appt-selected .appt_30_body,
.appt-selected .appt_allday_body{
  box-shadow:0 0 0 1px #666, 0 2px 4px rgba(0,0,0,.15);
}
.appt-selected .appt_body TABLE,
.appt-selected .appt_30_body TABLE,
.appt-selected .appt_allday_body TABLE{
  border-color:transparent!important;
}
    
/* Table interne : plus de bordure */
.appt_body>table,
.appt_30_body>table,
.appt_allday_body>table{
  border:0!important;
}

/* Bande d'origine neutralisée */
.appt_body td[width="4"],
.appt_30_body td[width="4"],
.appt_allday_body td[width="4"]{
  background:none!important;
}

/* Nouvelle bande */
.appt_body::before,
.appt_30_body::before,
.appt_allday_body::before{
  content:"";
  position:absolute;
  top:0; bottom:0; left:0;
  width:4px;
  background:none;
  backdrop-filter:saturate(6) brightness(.85);
  pointer-events:none;
}
  /* Dégradé du tr (créneaux 30 min) */
.appt_body tr[style*="gradient"],
.appt_30_body tr[style*="gradient"],
.appt_allday_body tr[style*="gradient"]{
  background:none!important;
}

/* Bande d'origine : sélecteur tolérant "4" / "4px" */
.appt_body td[width^="4"],
.appt_30_body td[width^="4"],
.appt_allday_body td[width^="4"]{
  background:none!important;
}  

/* Fond hors période (inline → !important) */
.calendar_body>.ImgCalendarDayGrid{
  background-color:#f2f2f2!important;   /* #fff pour supprimer */
}

/* Jour actif : en-tête */
.calendar_heading_day_today,
.calendar_heading_day_today-selected{
  background-color:#bdc9c7!important;
  color:#466964;
  font-weight:bold;
  border-radius:var(--radius) var(--radius) 0 0;
}
    
.calendar_cur_time_indicator_container{
  overflow:visible!important;
}
.calendar_cur_time_indicator_container::before{
  content:"";
  position:absolute;
  left:0; width:100%;
  top:-3000px; height:3000px;          /* de 0h à l'heure courante */
  background:rgba(70,105,100,.08);     /* --c-primary à 8 % */
  pointer-events:none;
}  
    .calendar_cur_time_indicator_strip{
  height:1px;      /* épaisseur du trait */
  margin:0;
}
    
    
    
}
